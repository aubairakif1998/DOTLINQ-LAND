# Public site
NEXT_PUBLIC_SITE_URL=https://www.dotlinq.com

# Legacy password-only admin at /admin
ADMIN_PASSWORD=

# Aubair admin at /aubairadmin (username + password)
AUBAIR_ADMIN_USERNAME=aubair
AUBAIR_ADMIN_PASSWORD=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Required — server waitlist writes + admin reads (bypasses RLS)
SUPABASE_SECRET_KEY=sb_secret_...

# Optional — for `npm run db:migrate` only
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
